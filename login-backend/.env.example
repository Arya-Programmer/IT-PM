# Supabase project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase anon key with permission to run password authentication
SUPABASE_ANON_KEY=

# Supabase service role key (required for creating users and bypassing RLS)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides for where to read the user role from
# SUPABASE_PROFILE_TABLE=profiles
# SUPABASE_PROFILE_ROLE_COLUMN=role
# SUPABASE_PROFILE_USER_ID_COLUMN=user_id
# SUPABASE_PROFILE_CREATED_BY_ADMIN_COLUMN=created_by_admin
# SUPABASE_PROFILE_FULL_NAME_COLUMN=full_name
# SUPABASE_PROFILE_CREATED_BY_COLUMN=created_by

# Optional override for the value that denotes an administrator role
# SUPABASE_ADMIN_ROLE_VALUE=admin
